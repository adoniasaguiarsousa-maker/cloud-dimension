    var ga = new GlideAjax('AllocatorUtils');
    ga.addParam('sysparm_name', 'canUserAllocate');
    ga.getXMLAnswer(function(response) {
        var canAllocate = response === 'true';

        if (!canAllocate) {
            g_form.addErrorMessage('You already have an active enrollment and cannot register for another branch.');
            g_form.clearValue('base_name');
        }
    });
}
